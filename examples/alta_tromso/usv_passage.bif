  (high, medium, medium, high)        0.005, 0.078, 0.917;
  (high, medium, high, low)           0.005, 0.078, 0.917;
  (high, medium, high, medium)        0.005, 0.078, 0.917;
  (high, medium, high, high)          0.005, 0.078, 0.917;
  (high, high, low, low)              0.005, 0.078, 0.917;
